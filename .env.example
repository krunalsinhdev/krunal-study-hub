# Copy this file to .env and replace both values before starting the API.
# The admin account is created once, on first backend startup.
ADMIN_USER_ID=admin
ADMIN_PASSWORD=123

# Keep database and PDFs outside the frontend's public directory.
STUDY_HUB_DATA_DIR=./data
STUDY_HUB_UPLOAD_DIR=./uploads
STUDY_HUB_MAX_UPLOAD_MB=50
STUDY_HUB_SESSION_HOURS=8
STUDY_HUB_REMEMBER_DAYS=30

# Set true behind HTTPS in production. Keep false for local HTTP development.
STUDY_HUB_COOKIE_SECURE=false
